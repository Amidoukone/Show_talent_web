# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Node.js dependencies
node_modules/

# Firebase Hosting deploy artifacts
.firebase/
firebase-debug.log*

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Firebase Admin credentials
.credentials/
serviceAccount*.json
firebase-adminsdk*.json

# Environment / local secrets
.env
.env.*
*.env
*.env.*

# Local platform config files (avoid accidental key exposure)
android/local.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
# lib/firebase_options.dart is intentionally tracked: it's the FlutterFire-
# generated client config (not a secret -- see Firebase's own docs; access
# control is Security Rules/App Check, not hiding this file), and
# firebase_bootstrap.dart imports it unconditionally, so a fresh clone
# can't even compile without it.

# Local web build config (Firebase Web SDK values per environment)
config/*.json
!config/*.example.json

# Keys / certificates
*.pem
*.key
*.p12
*.pfx
